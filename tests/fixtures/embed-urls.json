{
	"_comment": "BSWP-34/46 golden fixture. The PHP suite (tests/php/test-embed-parity.php) and the JS suite (tests/js/embed-parity.test.ts) both assert booksurfer_build_embed_url()/buildEmbedUrl() return `expected` byte-for-byte for each case. Any divergence fails CI. apiBase is pinned so the fixture is host-independent.",
	"apiBase": "https://api.booksurfer.in/api",
	"cases": [
		{
			"name": "class / classic / default styling / SaaS-provided base",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "classic"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=classic&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / modern",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "modern"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=modern&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / minimal",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "minimal"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=minimal&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / compact",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "compact"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=compact&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / unknown layout falls back to classic",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "bogus"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=classic&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / a prototype-chain key is not a valid layout",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42",
				"layout": "constructor"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?layout=classic&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "allInOne / a prototype-chain key is not a valid style",
			"atts": {
				"variant": "allInOne",
				"studioHandle": "demo-studio",
				"allInOneStyle": "toString"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book?primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / no provided base, built from handle + id",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "abc-123",
				"layout": "classic"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/abc-123?layout=classic&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / base with a pre-existing query param preserves it first",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",
				"classId": "42",
				"embedUrl": "https://api.booksurfer.in/api/demo-studio/book/42?ref=xyz",
				"layout": "classic"
			},
			"expected": "https://api.booksurfer.in/api/demo-studio/book/42?ref=xyz&layout=classic&primary=0D9488&text=1e293b&bg=ffffff&font=Roboto&radius=14"
		},
		{
			"name": "class / custom styling, # stripped from colours",
			"atts": {
				"variant": "class",
				"studioHandle": "demo-studio",

{
	"name": "book-surfer",
	"version": "1.0.0",
	"description": "Add live Book Surfer booking forms and schedules to your WordPress site.",
	"author": "Book Surfer",
	"license": "GPL-2.0-or-later",
	"private": true,
	"keywords": [
		"wordpress",
		"gutenberg",
		"block",
		"booking"
	],
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style",
		"format": "wp-scripts format",
		"typecheck": "tsc --noEmit",
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:watch": "wp-scripts test-unit-js --watch",
		"test:e2e": "playwright test",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:clean": "wp-env clean all",
		"makepot": "wp i18n make-pot . languages/book-surfer.pot --exclude=node_modules,build,tests,stub,vendor",
		"plugin-zip": "wp-scripts plugin-zip",
		"stub": "node stub/server.js"
	},
	"dependencies": {},
	"devDependencies": {
		"@playwright/test": "^1.48.0",
		"@types/jest": "^29.5.12",
		"@types/node": "^20.16.0",
		"@types/wordpress__block-editor": "^11.5.16",
		"@types/wordpress__blocks": "^12.5.14",
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/block-editor": "^14.0.0",
		"@wordpress/blocks": "^13.0.0",
		"@wordpress/components": "^28.0.0",
		"@wordpress/e2e-test-utils-playwright": "^1.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/i18n": "^5.0.0",
		"@wordpress/icons": "^10.0.0",
		"@wordpress/scripts": "^30.0.0",
		"autoprefixer": "^10.4.20",
		"copy-webpack-plugin": "^12.0.2",
		"postcss": "^8.4.47",
		"tailwindcss": "^3.4.14",
		"typescript": "^5.6.0"
	},
	"engines": {
		"node": ">=18"
	}
}

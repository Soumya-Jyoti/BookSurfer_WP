{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"lib": [ "DOM", "DOM.Iterable", "ESNext" ],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"baseUrl": ".",
		"paths": {
			"@shared/*": [ "./src/shared/*" ]
		},
		"types": [ "jest", "node" ]
	},
	"include": [ "src", "tests/js" ],
	"exclude": [ "node_modules", "build", "vendor", "stub" ]
}

# Files excluded from the plugin distributed to WordPress.org.
#
# This file is the single list of what must NOT ship. It is read by two things:
#
#   * bin/build.sh, the manual release path. Copies the repo to ../book-surfer-build
#     with these patterns excluded, normalises text files to LF, verifies the result
#     and prints the tree. Run it before every SVN release (see RELEASE.md).
#   * 10up/action-wordpress-plugin-deploy, the optional CI publish step in
#     .github/workflows/release.yml. Uses this file as an rsync exclude list. It only
#     runs when the WPORG_SLUG repository variable is set. Leave it unset while
#     releasing by hand, or the two paths will race each other.
#
# Pattern semantics are rsync/gitignore style: a bare name matches at any depth
# (so `README.md` also drops languages/README.md); a pattern containing `/` is
# matched against the path relative to the repo root; `*` wildcards are allowed.
#
# `wp-scripts plugin-zip` (npm run plugin-zip, used for the GitHub Release zip)
# IGNORES this file. It globs a hardcoded, case-insensitive allowlist:
#     admin/**  build/**  includes/**  languages/**  public/**
#     book-surfer.php  uninstall.php  block.json  changelog.*  license.*  readme.*
# so that zip additionally contains README.md (matched by `readme.*`). That is the
# only permitted difference between the GitHub zip and the SVN trunk.
#
# The payload the WordPress.org build must produce, and nothing more:
#
#     book-surfer.php  uninstall.php  readme.txt  LICENSE.txt
#     includes/**  build/**  languages/  (empty until a .pot ships)

# Version control
.git
.github
.gitignore
.gitattributes
.distignore
.editorconfig

# Dependencies. vendor/ is dev-only: composer.json has no runtime "require"
# beyond php itself, and no shipped file loads vendor/autoload.php.
node_modules
vendor
composer.json
composer.lock
composer.phar
package.json
package-lock.json

# Sources (compiled into build/, see the "Source code" section of readme.txt)
src

# Build + tooling config
webpack.config.js
postcss.config.js
tailwind.config.js
tsconfig.json
jest.config.js
playwright.config.ts
.wp-env.json
.wp-env.override.json
*.map

# Linting / static analysis
phpcs.xml
phpstan.neon
phpstan.neon.dist
.phpunit.result.cache

# Tests and local dev harness
tests
stub
phpunit.xml
phpunit.xml.dist
coverage
playwright-report
test-results

# Developer-facing docs and release tooling (readme.txt is the user-facing one)
docs
README.md
CONTRIBUTING.md
RELEASE.md
bin

# Directory art: published to SVN assets/ by hand or by the deploy action, never to trunk/
.wordpress-org

# Local env / editors / OS
.env
.env.local
.npmrc
.idea
.vscode
.DS_Store
Thumbs.db
*.log
*.tsbuildinfo

# Distribution artifacts
*.zip
dist

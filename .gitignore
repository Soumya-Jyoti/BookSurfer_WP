# Build output — regenerated by `npm run build`, never committed.
/build/
/languages/*.mo

# Dependencies
/node_modules/
/vendor/

# Package-manager local config / caches (never commit a machine-local registry)
.npmrc
*.tsbuildinfo

# Test + tooling output
/coverage/
/playwright-report/
/test-results/
.phpunit.result.cache
/phpunit.xml
/phpstan.neon

# Distribution
/book-surfer.zip
/*.zip
/dist/

# Local env
.env
.env.local
/.wp-env.override.json

# Agent/plan scratch that lands in the working dir — never part of the plugin.
/bswp-jira-backlog-md-*.md
/check-and-verify-*.md

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
